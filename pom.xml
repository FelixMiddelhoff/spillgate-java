<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.felixmiddelhoff</groupId>
  <artifactId>spillgate-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>spillgate (parent)</name>
  <description>Parent of spillgate-java: decode untrusted compressed data (gzip, deflate, brotli, zstd) with mandatory limits.</description>
  <url>https://github.com/FelixMiddelhoff/spillgate-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>FelixMiddelhoff</id>
      <name>Felix Middelhoff</name>
      <url>https://github.com/FelixMiddelhoff</url>
    </developer>
  </developers>
  <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false">
    <url>https://github.com/FelixMiddelhoff/spillgate-java</url>
    <connection>scm:git:https://github.com/FelixMiddelhoff/spillgate-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/FelixMiddelhoff/spillgate-java.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>core</module>
    <module>zstd</module>
    <module>brotli</module>
    <module>test-support</module>
    <module>conformance</module>
    <module>howto</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <spillgate.version>${project.version}</spillgate.version>
    <project.build.outputTimestamp>2026-11-11T00:00:00Z</project.build.outputTimestamp>
    <autoPublish>false</autoPublish>
    <skipPublishing>false</skipPublishing>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.felixmiddelhoff</groupId>
        <artifactId>spillgate</artifactId>
        <version>${spillgate.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.felixmiddelhoff</groupId>
        <artifactId>spillgate-zstd</artifactId>
        <version>${spillgate.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.felixmiddelhoff</groupId>
        <artifactId>spillgate-brotli</artifactId>
        <version>${spillgate.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.felixmiddelhoff</groupId>
        <artifactId>spillgate-test-support</artifactId>
        <version>${spillgate.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>17</release>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      Publishing to Maven Central (see RELEASING.md). Normal builds need no keys and do not use this profile:
      sources and javadoc jars, GPG signatures and the upload to the Central Portal are added only here.
      Check it without keys with: mvn -DskipTests -Prelease -Dgpg.skip package
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>all,-missing</doclint>
              <failOnWarnings>true</failOnWarnings>
              <failOnError>true</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- the key comes from the environment (GPG_PRIVATE_KEY, GPG_PASSPHRASE) in CI -->
                  <bestPractices>true</bestPractices>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- the upload is validated and then waits for the manual "Publish" in the portal unless -DautoPublish=true -->
              <autoPublish>${autoPublish}</autoPublish>
              <skipPublishing>${skipPublishing}</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
